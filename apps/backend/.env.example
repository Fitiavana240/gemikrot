# Le mot de passe doit être celui de POSTGRES_PASSWORD (.env de la racine).
DATABASE_URL="postgresql://wifitati:MOT_DE_PASSE@localhost:55432/wifitati?schema=public"

# Connexion RouterOS REST utilisée par MikrotikModule (src/mikrotik).
# Utiliser le compte API dédié (jamais "admin", Section 35).
MIKROTIK_BASE_URL="https://192.168.88.1"
MIKROTIK_USERNAME=""
MIKROTIK_PASSWORD=""
# "false" tant que le certificat www-ssl du routeur est auto-signé non
# épinglé (lab). Ne jamais mettre "false" pour un routeur distant en prod :
# enregistrer plutôt l'empreinte TLS du routeur (épinglage).
MIKROTIK_TLS_REJECT_UNAUTHORIZED="true"

# Chiffrement AES-256-GCM des identifiants routeur stockés en base
# (Section 35). 32 octets en hexadécimal : `openssl rand -hex 32`.
# Sa perte rend tous les routeurs enregistrés inutilisables.
ROUTER_CREDENTIALS_KEY=""

# Signature des JWT d'authentification admin (src/auth). Générer une valeur
# aléatoire dédiée par environnement, ex: `openssl rand -hex 32`.
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Origine(s) autorisée(s) à appeler l'API depuis un navigateur (apps/frontend).
# Plusieurs origines séparées par des virgules en production.
CORS_ORIGIN="http://localhost:5173"

# Compte SUPER_ADMIN créé par `npm run seed` (exploitant de la plateforme).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Tunnel WireGuard : raccordement des routeurs distants.
#
# Le routeur appelle le serveur, jamais l'inverse — un routeur derrière la 4G
# ou un NAT d'opérateur n'a ni adresse fixe ni port ouvert. Ces valeurs sont
# celles que le script d'enrôlement inscrira sur le routeur.
#
# Sur le serveur, deux réglages ne sont pas facultatifs : interdire le routage
# entre pairs (wg0 vers wg0 rejeté en forward), sans quoi le routeur d'un
# exploitant atteint celui d'un autre ; et sauvegarder /etc/wireguard
# séparément du dump de la base.
# ---------------------------------------------------------------------------
WIREGUARD_ENDPOINT_HOST=""
WIREGUARD_ENDPOINT_PORT="51820"
WIREGUARD_SERVER_PUBLIC_KEY=""
WIREGUARD_SUBNET="10.88.0.0/16"
WIREGUARD_SERVER_ADDRESS="10.88.0.1"
WIREGUARD_INTERFACE="wg0"
# "true" seulement sur le serveur Linux qui porte l'interface : l'application
# y ajoute les pairs avec `wg`. Ailleurs, elle rend la commande à passer à la
# main plutôt que de faire croire le tunnel monté.
WIREGUARD_MANAGED="false"

# Adresse publique de l'application, telle que le routeur doit la joindre pour
# confirmer son enrôlement.
PUBLIC_BASE_URL=""

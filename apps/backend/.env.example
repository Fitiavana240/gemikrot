# Le mot de passe doit être celui de POSTGRES_PASSWORD (.env de la racine).
DATABASE_URL="postgresql://wifitati:MOT_DE_PASSE@localhost:55432/wifitati?schema=public"

# Connexion RouterOS REST utilisée par MikrotikModule (src/mikrotik).
# Utiliser le compte API dédié (jamais "admin", Section 35).
MIKROTIK_BASE_URL="https://192.168.88.1"
MIKROTIK_USERNAME=""
MIKROTIK_PASSWORD=""
# "false" tant que le certificat www-ssl du routeur est auto-signé non
# épinglé (lab). Ne jamais mettre "false" pour un routeur distant en prod :
# enregistrer plutôt l'empreinte TLS du routeur (épinglage).
MIKROTIK_TLS_REJECT_UNAUTHORIZED="true"

# Chiffrement AES-256-GCM des identifiants routeur stockés en base
# (Section 35). 32 octets en hexadécimal : `openssl rand -hex 32`.
# Sa perte rend tous les routeurs enregistrés inutilisables.
ROUTER_CREDENTIALS_KEY=""

# Signature des JWT d'authentification admin (src/auth). Générer une valeur
# aléatoire dédiée par environnement, ex: `openssl rand -hex 32`.
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Origine(s) autorisée(s) à appeler l'API depuis un navigateur (apps/frontend).
# Plusieurs origines séparées par des virgules en production.
CORS_ORIGIN="http://localhost:5173"

# Compte SUPER_ADMIN créé par `npm run seed` (exploitant de la plateforme).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

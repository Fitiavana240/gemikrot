generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// Exploitant de la plateforme : un réseau Wi-Fi commercial, sa marque, ses
/// routeurs et ses clients. Le SUPER_ADMIN n'appartient à aucun tenant et
/// voit l'ensemble.
model Tenant {
  id        String       @id @default(uuid())
  name      String
  /// Nom du réseau Wi-Fi affiché aux clients finaux.
  wifiName  String       @map("wifi_name")
  /// Domaines du portail captif (ex: wifitati.net).
  domains   String[]     @default([])
  logoUrl   String?      @map("logo_url")
  /// Code ISO 4217 : MGA, USD, EUR… choisi par l'exploitant.
  currency  String       @default("MGA")
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  adminUsers          AdminUser[]
  mobileMoneyAccounts MobileMoneyAccount[]
  routers             Router[]
  plans               Plan[]
  customers           Customer[]
  subscriptions       Subscription[]
  vouchers            Voucher[]
  voucherBatches      VoucherBatch[]
  payments            Payment[]
  devices             Device[]
  auditLogs           AuditLog[]

  @@map("tenants")
}

/// Puce Mobile Money de l'exploitant : le numéro est affiché au client pour
/// qu'il sache où payer, et sert de clé de rattachement des paiements reçus.
model MobileMoneyAccount {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider    PaymentMethod
  phoneNumber String        @map("phone_number")
  /// Nom du titulaire de la puce, tel qu'il apparaît au client qui paie.
  accountName String        @map("account_name")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([provider, phoneNumber])
  @@index([tenantId])
  @@map("mobile_money_accounts")
}

/// Valeurs telles que RouterOS les nomme sur `/user-manager/profile` :
/// `first-auth` fait courir la validité à la première authentification,
/// `assigned` dès l'attribution du profil.
enum ProfileStartsWhen {
  FIRST_AUTH
  ASSIGNED
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

/// Distingue les offres à la durée (tickets, majorité du parc) des
/// abonnements renouvelés au paiement (Section 5 du cahier des charges).
enum PlanKind {
  TICKET
  SUBSCRIPTION
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  SUSPENDED
  CANCELLED
}

/// Sert à décider si un appareil peut afficher le portail captif : une TV ou
/// une caméra ne le peut pas et nécessite un contournement par MAC.
enum DeviceType {
  PHONE
  COMPUTER
  TV
  CAMERA
  ROUTER
  OTHER
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum VoucherStatus {
  CREATED
  SOLD
  ACTIVE
  EXPIRED
  DISABLED
  CANCELLED
}

enum VoucherBatchStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  CASH
  ORANGE_MONEY
  MVOLA
  AIRTEL_MONEY
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
  REFUNDED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model AdminUser {
  id           String    @id @default(uuid())
  /// `null` pour le SUPER_ADMIN, qui n'appartient à aucun exploitant.
  tenantId     String?   @map("tenant_id")
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(OPERATOR)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?   @map("mfa_secret")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs      AuditLog[]
  createdBatches VoucherBatch[]
  verifiedPayments Payment[]

  @@map("admin_users")
}

model Router {
  id                   String    @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  label                String
  host                 String
  restPort             Int       @default(443) @map("rest_port")
  apiPort              Int       @default(8729) @map("api_port")
  credentialsEncrypted String    @map("credentials_encrypted")
  tlsFingerprint       String?   @map("tls_fingerprint")
  status               String    @default("unknown")
  lastSeenAt           DateTime? @map("last_seen_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  voucherBatches       VoucherBatch[]
  userCache            UserCacheEntry[]
  sessionCache         SessionCacheEntry[]
  statsCache           StatsCacheEntry[]
  auditLogs            AuditLog[]
  subscriptions        Subscription[]
  devices              Device[]

  @@map("routers")
}

/// Offre commerciale (Sections 4, 14, 15). Le prix et les paramètres réseau
/// vivent ici, jamais codés en dur dans l'application.
model Plan {
  id                       String     @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name                     String
  description              String?
  price                    Decimal    @db.Decimal(12, 2)
  validityDurationSeconds  Int        @map("validity_duration_seconds")
  startsWhen               ProfileStartsWhen @default(FIRST_AUTH) @map("starts_when")
  rateLimitRxBps           Int?       @map("rate_limit_rx_bps")
  rateLimitTxBps           Int?       @map("rate_limit_tx_bps")
  transferLimitBytes       BigInt?    @map("transfer_limit_bytes")
  maxSharedUsers           Int?       @map("max_shared_users")
  mikrotikProfileName      String     @map("mikrotik_profile_name")
  status                   PlanStatus @default(ACTIVE)
  kind                     PlanKind   @default(TICKET)
  /// Longueur d'une période d'abonnement (null pour les offres à ticket).
  subscriptionPeriodDays   Int?       @map("subscription_period_days")
  /// `session-timeout` du profil HotSpot : limite une session, pas l'abonnement.
  sessionTimeoutSeconds    Int?       @map("session_timeout_seconds")
  /// Prix déduit du nom du profil lors de l'import, à confirmer par un admin.
  priceNeedsReview         Boolean    @default(false) @map("price_needs_review")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  voucherBatches VoucherBatch[]
  vouchers       Voucher[]
  payments       Payment[]
  subscriptions  Subscription[]

  @@unique([tenantId, name])
  @@unique([tenantId, mikrotikProfileName])
  @@map("plans")
}

/// Abonnement récurrent (Section 5), porté par un compte User Manager dont
/// la validité est calendaire. L'échéance fait autorité côté routeur
/// (`end-time` sur `/user-manager/user-profile`) et est réconciliée ici ;
/// PostgreSQL garde le suivi commercial (client, offre, paiements).
model Subscription {
  id                 String             @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  customerId         String             @map("customer_id")
  customer           Customer           @relation(fields: [customerId], references: [id])
  planId             String             @map("plan_id")
  plan               Plan               @relation(fields: [planId], references: [id])
  routerId           String             @map("router_id")
  router             Router             @relation(fields: [routerId], references: [id])
  /// Nom du compte tel qu'il existe dans `/user-manager/user`.
  hotspotUsername    String             @map("hotspot_username")
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  /// Fin de la tolérance de 7 jours après expiration, avant suspension.
  graceEndsAt        DateTime           @map("grace_ends_at")
  suspendedAt        DateTime?          @map("suspended_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  payments Payment[]
  devices  Device[]

  @@unique([routerId, hotspotUsername])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

/// Client final (Section 19).
model Customer {
  id        String         @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  phone     String
  email     String?
  address   String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  devices       Device[]
  vouchers      Voucher[]
  payments      Payment[]
  subscriptions Subscription[]

  @@unique([tenantId, phone])
  @@map("customers")
}

/// Appareil associé à un client (Section 20). La MAC n'est volontairement PAS
/// unique : un CPE en NAT peut représenter plusieurs appareils réels derrière
/// une seule adresse côté HotSpot (ne jamais supposer 1 MAC = 1 appareil).
model Device {
  id           String     @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  customerId   String?    @map("customer_id")
  customer     Customer?  @relation(fields: [customerId], references: [id])
  routerId     String?    @map("router_id")
  router       Router?    @relation(fields: [routerId], references: [id])
  subscriptionId String?  @map("subscription_id")
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  macAddress   String     @map("mac_address")
  ipAddress    String?    @map("ip_address")
  hostname     String?
  /// Type retenu — proposé par détection, puis confirmé par un admin.
  type         DeviceType @default(OTHER)
  /// Ce que la détection automatique avait proposé, conservé pour audit.
  detectedType DeviceType? @map("detected_type")
  /// Ce sur quoi la détection s'est appuyée (nom DHCP, fabricant MAC…).
  detectionSource String?  @map("detection_source")
  /// Vrai quand un ip-binding `bypassed` existe pour cet appareil.
  bypassEnabled   Boolean  @default(false) @map("bypass_enabled")
  /// `.id` de l'entrée `/ip/hotspot/ip-binding` correspondante.
  mikrotikBindingId String? @map("mikrotik_binding_id")
  firstSeenAt  DateTime   @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime   @default(now()) @map("last_seen_at")

  vouchers Voucher[]

  @@index([macAddress])
  @@map("devices")
}

model VoucherBatch {
  id          String              @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  routerId    String              @map("router_id")
  router      Router              @relation(fields: [routerId], references: [id])
  planId      String              @map("plan_id")
  plan        Plan                @relation(fields: [planId], references: [id])
  quantity    Int
  prefix      String?
  status      VoucherBatchStatus  @default(PENDING)
  createdByAdminId String         @map("created_by_admin_id")
  createdByAdmin   AdminUser      @relation(fields: [createdByAdminId], references: [id])
  createdAt   DateTime            @default(now()) @map("created_at")

  jobs     VoucherJob[]
  vouchers Voucher[]

  @@map("voucher_batches")
}

model VoucherJob {
  id           String    @id @default(uuid())
  batchId      String    @map("batch_id")
  batch        VoucherBatch @relation(fields: [batchId], references: [id])
  processed    Int       @default(0)
  total        Int
  status       String    @default("queued")
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  @@map("voucher_jobs")
}

/// Voucher individuel (Section 17). `code` sert à la fois de nom
/// d'utilisateur et de mot de passe côté HotSpot/User Manager, pour que le
/// client n'ait qu'un seul champ à saisir (Section 6).
model Voucher {
  id          String        @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String        @unique
  batchId     String?       @map("batch_id")
  batch       VoucherBatch? @relation(fields: [batchId], references: [id])
  planId      String        @map("plan_id")
  plan        Plan          @relation(fields: [planId], references: [id])
  price       Decimal       @db.Decimal(12, 2)
  status      VoucherStatus @default(CREATED)
  customerId  String?       @map("customer_id")
  customer    Customer?     @relation(fields: [customerId], references: [id])
  deviceId    String?       @map("device_id")
  device      Device?       @relation(fields: [deviceId], references: [id])
  payment     Payment?
  createdAt   DateTime      @default(now()) @map("created_at")
  activatedAt DateTime?     @map("activated_at")
  expiresAt   DateTime?     @map("expires_at")

  @@index([status])
  @@map("vouchers")
}

/// Paiement (Sections 22-24). La contrainte unique (method, reference)
/// garantit l'idempotence : une même référence ne peut jamais être vérifiée
/// deux fois ni générer deux accès.
model Payment {
  id                 String        @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  customerId         String        @map("customer_id")
  customer           Customer      @relation(fields: [customerId], references: [id])
  planId             String        @map("plan_id")
  plan               Plan          @relation(fields: [planId], references: [id])
  amount             Decimal       @db.Decimal(12, 2)
  /// Devise au moment du paiement, figée même si l'exploitant en change.
  currency           String
  method             PaymentMethod
  reference          String
  status             PaymentStatus @default(PENDING)
  /// Un paiement solde soit un voucher (ticket), soit une période d'abonnement.
  voucherId          String?       @unique @map("voucher_id")
  voucher            Voucher?      @relation(fields: [voucherId], references: [id])
  subscriptionId     String?       @map("subscription_id")
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  verifiedByAdminId  String?       @map("verified_by_admin_id")
  verifiedByAdmin    AdminUser?    @relation(fields: [verifiedByAdminId], references: [id])
  createdAt          DateTime      @default(now()) @map("created_at")
  verifiedAt         DateTime?     @map("verified_at")

  @@unique([tenantId, method, reference])
  @@map("payments")
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String?     @map("tenant_id")
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  adminUserId String?     @map("admin_user_id")
  adminUser   AdminUser?  @relation(fields: [adminUserId], references: [id])
  routerId    String?     @map("router_id")
  router      Router?     @relation(fields: [routerId], references: [id])
  action      String
  targetType  String      @map("target_type")
  targetId    String?     @map("target_id")
  payloadDiff Json?       @map("payload_diff")
  ipAddress   String?     @map("ip_address")
  result      AuditResult @default(SUCCESS)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("audit_logs")
  @@index([createdAt])
}

model UserCacheEntry {
  id       String   @id @default(uuid())
  routerId String   @map("router_id")
  router   Router   @relation(fields: [routerId], references: [id])
  username String
  payload  Json
  syncedAt DateTime @default(now()) @map("synced_at")

  @@unique([routerId, username])
  @@map("user_cache")
}

model SessionCacheEntry {
  id        String   @id @default(uuid())
  routerId  String   @map("router_id")
  router    Router   @relation(fields: [routerId], references: [id])
  sessionId String   @map("session_id")
  payload   Json
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@unique([routerId, sessionId])
  @@map("session_cache")
}

model StatsCacheEntry {
  id       String   @id @default(uuid())
  routerId String   @map("router_id")
  router   Router   @relation(fields: [routerId], references: [id])
  scopeKey String   @map("scope_key")
  payload  Json
  syncedAt DateTime @default(now()) @map("synced_at")

  @@unique([routerId, scopeKey])
  @@map("stats_cache")
}
